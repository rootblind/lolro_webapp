# Anti-alt detection tuning knobs.
# Every value below shows the CURRENT DEFAULT (from graph.ts / risk.ts).
# Commenting and uncommenting works as a switch for custom values

# Graph / clustering (graph.ts)
# Minimum similarity score (0-100) before two accounts are even considered
# "related" and get an edge in the graph at all. Below this, a pair is
# invisible to the whole system, not just under-weighted.
# ANTIALT_MIN_EDGE_SCORE=75

# Minimum number of matching components required for an edge.
# ANTIALT_MIN_MATCHING_COMPONENTS=4

# Minimum number of comparable components required for an edge.
# ANTIALT_MIN_COMPARABLE_COMPONENTS=4

# Max fingerprint observations retained per account (rolling window).
# ANTIALT_MAX_OBSERVATIONS_PER_ACCOUNT=10

# Max candidate accounts considered per new observation (perf guard).
# ANTIALT_MAX_CANDIDATES_PER_OBSERVATION=500

# How long an observation stays eligible for candidate matching, in ms.
# Default is 365 days.
# ANTIALT_OBSERVATION_TTL_MS=31536000000

# Risk scoring (risk.ts)
# Similarity score (0-100) a relationship must cross to earn ANY
# fingerprint-similarity risk points. NOTE: this is a separate value from
# ANTIALT_MIN_EDGE_SCORE above, a relationship can exist in the graph
# (visible, tracked) without yet earning risk points.
# ANTIALT_FINGERPRINT_SCORE_THRESHOLD=75

# Similarity score considered a "strong" relationship (feeds strongFingerprintRelationship and higher point tiers).
# ANTIALT_STRONG_FINGERPRINT_SCORE_THRESHOLD=85

# Similarity score considered "critical" (highest fingerprint point tier).
# ANTIALT_CRITICAL_FINGERPRINT_SCORE_THRESHOLD=92

# Cap on total points a fingerprint relationship can contribute, so a large
# cluster alone can't reach 100 on fingerprint evidence alone.
# ANTIALT_MAX_FINGERPRINT_POINTS=60

# Points added when a related account is currently banned.
# ANTIALT_RELATED_BANNED_ACCOUNT_POINTS=35

# Points added when a related account shares the same (hashed) email.
# ANTIALT_SHARED_EMAIL_POINTS=25

# Points added when a related account has already completed verification.
# ANTIALT_RELATED_VERIFIED_ACCOUNT_POINTS=5

# Points added when the fingerprint relationship has persisted across
# multiple independent observations (not a single coincidental match).
# ANTIALT_HISTORICAL_RELATIONSHIP_POINTS=10

# Score thresholds (0-100) mapping the final score to a risk level:
# ANTIALT_MODERATE_THRESHOLD=30
# ANTIALT_HIGH_THRESHOLD=60
# ANTIALT_CRITICAL_THRESHOLD=85

# Points added if the user doesn't have a custom avatar
# ANTIALT_NO_AVATAR_POINTS = 4

# Having premium (nitro) is a deduction trait as it usually requires spending real money
# ANTIALT_HAS_PREMIUM = 4

# Because an account can not join a guild/server before the account itself is created
# account age threshold must always be smaller than join age difference threshold
# Points are added for accounts with a creation date less than ANTIALT_ACCOUNT_AGE_THRESHOLD in days
# ANTIALT_ACCOUNT_AGE_THRESHOLD = 2
# ANTIALT_YOUNG_ACCOUNT_POINTS = 30
# Points are added when the difference between creation date and joining guild date is 
# less than ANTIALT_JOINED_AGE_DIFFERENCE
# ANTIALT_JOINED_AGE_DIFFERENCE_THRESHOLD = 3
# ANTIALT_JOINED_AGE_DIFFERENCE_POINTS = 15
# If the account was created and joined the server within the same 24h time frame, the multiplier is applied to
# joined age difference points
# ANTIALT_JOINED_SAME_DAY_MULTIPLIER = 2